#: content/_index.md:0
msgid "Recipe"
msgstr "レシピ"

#: content/_index.md:5
msgid "Welcome to Recipe, a small collection of easy dishes anyone can cook."
msgstr "「Recipe」へようこそ。誰でも作れる簡単な料理を集めた、小さなレシピ集です。"

#: content/recipes/_index.md:0
msgid "My Recipes"
msgstr ""

#: content/recipes/onigiri.md:0
msgid "Onigiri (Japanese Rice Balls)"
msgstr "おにぎり"

#: content/recipes/onigiri.md:6
msgid "Ingredients"
msgstr "材料"

#: content/recipes/onigiri.md:8
msgid "2 cups of cooked Japanese short-grain rice"
msgstr "炊いたごはん2カップ"

#: content/recipes/onigiri.md:9
msgid "1 sheet of nori seaweed"
msgstr "のり1枚"

#: content/recipes/onigiri.md:10
msgid "1 grilled salted salmon fillet, flaked"
msgstr "焼き鮭（塩鮭）1切れ（粗くほぐしておく）"

#: content/recipes/onigiri.md:11
msgid "Salt"
msgstr "塩"

#: content/recipes/onigiri.md:13
msgid "Steps"
msgstr "調理工程"

#: content/recipes/onigiri.md:15
msgid "Wet your hands with water and sprinkle them with salt."
msgstr ""

#: content/recipes/onigiri.md:16
msgid "Take a handful of warm rice and make a small well in the center."
msgstr ""

#: content/recipes/onigiri.md:17
msgid "Put the flaked salmon into the well and cover it with rice."
msgstr ""

#: content/recipes/onigiri.md:18
msgid "Gently press the rice into a triangle shape."
msgstr ""

#: content/recipes/onigiri.md:19
msgid "Wrap the rice ball with a strip of nori and serve."
msgstr ""
